# ==============================================================================
# ENVIRONMENT CONFIGURATION — PLAYQ SOLUTIONS
# ==============================================================================
# Copy this template to .env.local for local development or configure in your
# staging/production deployment environment (e.g. Vercel, Railway, AWS ECS).
#
# SECURITY MANDATE:
# Never commit real credentials, database passwords, or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical site URL used for sitemap.xml, robots.txt, metadata, and CSRF origin verification.
# Development: http://localhost:3000
# Staging:     https://staging.playqsolutions.com
# Production:  https://playqsolutions.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. PERSISTENCE LAYER — POSTGRESQL & PRISMA
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection string used by Prisma ORM.
# Required for persisting inquiries, internship applications, and admin credentials.
# Note: For automated local testing only, set DATABASE_URL="memory".
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require"

# Optional: Direct connection URL for migrations when using poolers (Supabase/Neon/PgBouncer)
DIRECT_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# High-entropy signing secret used for HMAC-SHA256 JWT administrative sessions.
# MUST be at least 32 characters long in production (generate via `openssl rand -hex 32`).
AUTH_SECRET="<generate-minimum-32-character-random-hex-secret>"

# Enforce secure cookies (defaults to true when NODE_ENV=production)
ADMIN_COOKIE_SECURE="true"

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING — UPSTASH REDIS
# ------------------------------------------------------------------------------
# Upstash REST credentials for distributed sliding-window token limiting across instances.
# When unconfigured or unreachable, the system automatically falls back to in-memory limiting.
UPSTASH_REDIS_REST_URL="https://<cluster-id>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-upstash-rest-token>"

# Backward-compatible aliases:
# RATE_LIMIT_REDIS_URL="https://<cluster-id>.upstash.io"
# RATE_LIMIT_REDIS_TOKEN="<your-upstash-rest-token>"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL NOTIFICATIONS — RESEND
# ------------------------------------------------------------------------------
# Used to dispatch internal alerts when new inquiries, applications, or proposals are submitted.
# Delivery runs via Resend REST API. Delivery failures never roll back persisted database records.
RESEND_API_KEY="re_<your_resend_api_key>"
NOTIFICATION_FROM_EMAIL="notifications@playqsolutions.com"
CONTACT_NOTIFICATION_EMAIL="contact@playqsolutions.com"
